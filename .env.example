# PostgreSQL — local (Docker): use a mesma URL em DATABASE_URL e DIRECT_URL
# Supabase — DATABASE_URL = pooler modo transação (porta 6543) + ?pgbouncer=true&connection_limit=1
#           DIRECT_URL = conexão direta (porta 5432 em db.<ref>.supabase.co) para prisma migrate
# Senha com caracteres especiais: codifique na URL (ex.: @ → %40)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_catalogo?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/saas_catalogo?schema=public"
#
# Exemplo Supabase (substitua REF, REGIÃO e senha):
# DATABASE_URL="postgresql://postgres.REF:SENHA@aws-0-REGIÃO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres:SENHA@db.REF.supabase.co:5432/postgres?sslmode=require"

# JWT Configuration (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your_long_random_secret_32_chars_minimum_length_here"
JWT_EXPIRES_IN="7d"

# Server Configuration
NODE_ENV=development
PORT=5000

# CORS Configuration (frontend origin)
CORS_ORIGIN="http://localhost:3000"

# Supabase (https://supabase.com/dashboard) — necessário para /api/supabase/demo-notes
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Cloudflare R2 (S3-compatible) — obrigatório para POST /api/products/:id/image e POST /api/stores/image
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_REGION="auto"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL pública do bucket (domínio customizado ou r2.dev), sem barra no final
R2_PUBLIC_BASE_URL=""
